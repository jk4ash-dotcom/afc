<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Offline POC: no INTERNET / storage / location permissions. -->

    <application
        android:name=".AfcApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AFCPrayerCompanion">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AFCPrayerCompanion"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Argus: strip emoji2/profileinstaller Startup meta-data by removing the
             empty androidx.startup.InitializationProvider entirely — leftover
             provider can reference a class not in the APK and crash at process start.
             Also strips EmojiCompatInitializer + ProfileInstallerInitializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />

        <!-- Shrink exported surface: ProfileInstallReceiver is exported=true from androidx. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />
    </application>
</manifest>
